{
  "name": "jbd-collab-booth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build && node scripts/fetch-assets.mjs",
    "start": "node server/index.js",
    "local": "npm install --no-audit --no-fund && npm run build && node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
